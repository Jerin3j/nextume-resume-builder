{
    "compilerOptions": {
        "target": "es2022",
         "module": "node20",
    "moduleResolution": "nodenext",
        "allowJs": true,
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "exclude": ["node_modules", "dist", "client"]
}
